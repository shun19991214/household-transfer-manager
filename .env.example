# Copy to .env.local and fill in. VITE_* values are inlined into the client bundle at build time.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional: named Firestore database (leave empty for "(default)")
VITE_FIREBASE_DATABASE_ID=

# Migration only (scripts/migrate-supabase-to-firestore.mjs). Remove after migration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Needed only if RLS blocks the anon key. Never prefix with VITE_ (would leak into the bundle).
SUPABASE_SERVICE_ROLE_KEY=

# Zaim (local dev proxy only)
VITE_ZAIM_CONSUMER_KEY=
VITE_ZAIM_CONSUMER_SECRET=
VITE_ZAIM_ACCESS_TOKEN=
VITE_ZAIM_ACCESS_TOKEN_SECRET=

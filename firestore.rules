rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(household) {
      return isSignedIn() && request.auth.uid in household.members;
    }

    // households/{householdId}
    //   members:   list<string>  Firebase Auth UIDs allowed to access this household
    //   data:      map           finance payload (fixedCosts, monthlyData, ...)
    //   updatedAt: timestamp
    //   updatedBy: string        UID of the last writer
    //
    // Households are created and their membership is changed only via the Admin SDK
    // (scripts/migrate-supabase-to-firestore.mjs, scripts/household-member.mjs).
    match /households/{householdId} {
      // list is allowed because the client queries with where('members', 'array-contains', uid)
      allow get, list: if isMember(resource.data);

      allow update: if isMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is map
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow create, delete: if false;
    }
  }
}
